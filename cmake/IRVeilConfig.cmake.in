@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(LLVM CONFIG)
if(NOT LLVM_VERSION_MAJOR EQUAL 18)
  set(IRVeil_FOUND FALSE)
  set(IRVeil_NOT_FOUND_MESSAGE "IRVeil 0.1 requires LLVM 18")
  return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/IRVeilTargets.cmake")
check_required_components(IRVeil)
