@PACKAGE_INIT@
if(NOT IRVeil_FIND_COMPONENTS)
  set(IRVeil_FIND_COMPONENTS Core)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/IRVeilPluginTargets.cmake")
set(IRVeil_Plugin_FOUND TRUE)
include("${CMAKE_CURRENT_LIST_DIR}/IRVeilTarget.cmake")
if("Core" IN_LIST IRVeil_FIND_COMPONENTS)
  include(CMakeFindDependencyMacro)
  find_dependency(LLVM CONFIG)
  if(NOT LLVM_VERSION_MAJOR EQUAL 18)
    set(IRVeil_FOUND FALSE)
    set(IRVeil_NOT_FOUND_MESSAGE "IRVeil requires LLVM 18")
    return()
  endif()
  include("${CMAKE_CURRENT_LIST_DIR}/IRVeilTargets.cmake")
  set(IRVeil_Core_FOUND TRUE)
endif()
check_required_components(IRVeil)
