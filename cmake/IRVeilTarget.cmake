include_guard(GLOBAL)

function(_irveil_decimal option value maximum output)
  if(NOT "${value}" MATCHES "^[0-9]+$")
    message(FATAL_ERROR "IRVeil ${option} must be an unsigned decimal integer; got '${value}'")
  endif()
  string(REGEX REPLACE "^0+" "" normalized "${value}")
  if(normalized STREQUAL "")
    set(normalized 0)
  endif()
  string(LENGTH "${normalized}" length)
  string(LENGTH "${maximum}" maximum_length)
  if(length GREATER maximum_length OR
      (length EQUAL maximum_length AND "${normalized}" STRGREATER "${maximum}"))
    message(FATAL_ERROR "IRVeil ${option} must be at most ${maximum}; got '${value}'")
  endif()
  set(${output} "${normalized}" PARENT_SCOPE)
endfunction()

function(irveil_protect_target target)
  if(NOT TARGET "${target}")
    message(FATAL_ERROR "IRVeil target '${target}' does not exist")
  endif()
  get_target_property(alias "${target}" ALIASED_TARGET)
  get_target_property(imported "${target}" IMPORTED)
  get_target_property(type "${target}" TYPE)
  if(alias OR imported OR NOT type MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY)$")
    message(FATAL_ERROR "IRVeil requires a local executable or compiled library target; got '${target}'")
  endif()
  get_target_property(configured "${target}" IRVEIL_CONFIGURED)
  if(configured)
    message(FATAL_ERROR "IRVeil target '${target}' is already configured")
  endif()
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR
      NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64)$")
    message(FATAL_ERROR "IRVeil target integration supports Linux x86-64 only")
  endif()
  get_target_property(sources "${target}" SOURCES)
  set(languages "")
  foreach(source IN LISTS sources)
    if(source MATCHES "^\\$<")
      continue()
    endif()
    get_source_file_property(language "${source}" TARGET_DIRECTORY "${target}" LANGUAGE)
    if(language)
      if(NOT language STREQUAL "C" AND NOT language STREQUAL "CXX")
        message(FATAL_ERROR "IRVeil target '${target}' has unsupported source language ${language}")
      endif()
      list(APPEND languages "${language}")
    endif()
  endforeach()
  if(NOT languages)
    get_property(languages GLOBAL PROPERTY ENABLED_LANGUAGES)
  endif()
  foreach(language IN LISTS languages)
    if((language STREQUAL "C" OR language STREQUAL "CXX") AND
        (NOT CMAKE_${language}_COMPILER_ID STREQUAL "Clang" OR
         CMAKE_${language}_COMPILER_VERSION VERSION_LESS 18 OR
         NOT CMAKE_${language}_COMPILER_VERSION VERSION_LESS 19))
      message(FATAL_ERROR "IRVeil requires Clang 18 for target language ${language}; found ${CMAKE_${language}_COMPILER_ID} ${CMAKE_${language}_COMPILER_VERSION}")
    endif()
  endforeach()
  get_target_property(ipo "${target}" INTERPROCEDURAL_OPTIMIZATION)
  if(ipo)
    message(FATAL_ERROR "IRVeil target '${target}' has INTERPROCEDURAL_OPTIMIZATION enabled; LTO is outside the supported contract")
  endif()
  set(configurations DEBUG RELEASE RELWITHDEBINFO MINSIZEREL ${CMAKE_CONFIGURATION_TYPES} "${CMAKE_BUILD_TYPE}")
  foreach(configuration IN LISTS configurations)
    string(TOUPPER "${configuration}" configuration)
    set(property "INTERPROCEDURAL_OPTIMIZATION_${configuration}")
    get_target_property(ipo "${target}" "${property}")
    if(ipo)
      message(FATAL_ERROR "IRVeil target '${target}' has ${property} enabled; LTO is outside the supported contract")
    endif()
  endforeach()

  set(seed 0)
  set(max_adds 256)
  set(report FALSE)
  set(pending "")
  set(seen_SEED FALSE)
  set(seen_MAX_ADDS FALSE)
  set(seen_REPORT FALSE)
  set(index 1)
  while(index LESS ARGC)
    set(argument "${ARGV${index}}")
    math(EXPR index "${index} + 1")
    if(NOT pending STREQUAL "")
      if(pending STREQUAL "SEED")
        _irveil_decimal(SEED "${argument}" 18446744073709551615 seed)
      else()
        _irveil_decimal(MAX_ADDS "${argument}" 4096 max_adds)
        if(max_adds STREQUAL "0")
          message(FATAL_ERROR "IRVeil MAX_ADDS must be between 1 and 4096; got '${argument}'")
        endif()
      endif()
      set(pending "")
    elseif(argument STREQUAL "SEED" OR argument STREQUAL "MAX_ADDS" OR argument STREQUAL "REPORT")
      if(seen_${argument})
        message(FATAL_ERROR "IRVeil option ${argument} was specified more than once")
      endif()
      set(seen_${argument} TRUE)
      if(argument STREQUAL "REPORT")
        set(report TRUE)
      else()
        set(pending "${argument}")
      endif()
    else()
      message(FATAL_ERROR "IRVeil unknown argument '${argument}'; expected SEED, MAX_ADDS or REPORT")
    endif()
  endwhile()
  if(NOT pending STREQUAL "")
    message(FATAL_ERROR "IRVeil option ${pending} requires a value")
  endif()

  target_include_directories("${target}" PRIVATE
    "$<TARGET_PROPERTY:IRVeil::Headers,INTERFACE_INCLUDE_DIRECTORIES>")
  # Clang must load option registrations before parsing -mllvm arguments.
  target_compile_options("${target}" PRIVATE
    "$<$<COMPILE_LANGUAGE:C,CXX>:SHELL:-Xclang -load -Xclang \"$<TARGET_FILE:IRVeil::Pass>\">"
    "$<$<COMPILE_LANGUAGE:C,CXX>:-fpass-plugin=$<TARGET_FILE:IRVeil::Pass>>"
    "$<$<COMPILE_LANGUAGE:C,CXX>:SHELL:-mllvm -irveil-seed=${seed}>"
    "$<$<COMPILE_LANGUAGE:C,CXX>:SHELL:-mllvm -irveil-max-adds=${max_adds}>")
  if(report)
    target_compile_options("${target}" PRIVATE "$<$<COMPILE_LANGUAGE:C,CXX>:SHELL:-mllvm -irveil-report>")
  endif()
  set_property(TARGET "${target}" PROPERTY IRVEIL_CONFIGURED TRUE)
endfunction()
